//@version=6
// =============================================================================
//  CRT PRO — Candle Range Theory (full methodology + stats)   XAUUSD / any pair
//
//  Core 3-candle model on a chosen HIGHER timeframe:
//    1) RANGE candle  -> high/low define the dealing range (+ 50% equilibrium)
//    2) MANIPULATION  -> next candle sweeps the range HIGH or LOW & CLOSES inside
//    3) DISTRIBUTION  -> price expected to reverse to the opposite side
//
//  Filters: key-level liquidity (PDH/PDL/PWH/PWL), London/NY killzones, EMA trend.
//  Trade plan: entry = 50% of sweep, SL = beyond wick, TP = opposite range side.
//  A) STATS TABLE  -> approximate win% / net-R tracker (limit fill, SL-before-TP).
//  B) LESS CLUTTER -> full entry/SL/TP plan shown only for the last N setups.
//
//  Non-repainting (closed HTF candles, lookahead off). Draws & alerts only —
//  it does not trade. The stats are an APPROXIMATION for guidance, not a backtest.
// =============================================================================
indicator("CRT Pro - Candle Range Theory", shorttitle="CRT Pro", overlay=true, max_boxes_count=200, max_lines_count=500, max_labels_count=500)

// ------------------------------- UDT ----------------------------------------
type Trade
    int   dir
    float entry
    float sl
    float tp
    float rr
    bool  filled
    int   startBar

// ------------------------------- Inputs -------------------------------------
crtTF         = input.timeframe("240", "CRT range timeframe", group="Core")
requireInside = input.bool(true,  "Sweep must close back INSIDE the range", group="Core")
extendBars    = input.int(4,      "Extend drawings (range bars)", minval=0, group="Core")

requireKeyLevel = input.bool(true, "Only sweeps that grab a key level (PDH/PDL/PWH/PWL)", group="Key levels & liquidity")
showKeyLevels   = input.bool(true, "Show key levels", group="Key levels & liquidity")

useSessions = input.bool(true, "Only take setups inside killzones", group="Sessions")
sessTz      = input.string("GMT", "Killzone timezone", options=["GMT","America/New_York","Europe/London"], group="Sessions")
lonStart    = input.int(7,  "London KZ start hour", minval=0, maxval=23, group="Sessions")
lonEnd      = input.int(10, "London KZ end hour",   minval=0, maxval=24, group="Sessions")
nyStart     = input.int(12, "New York KZ start hour", minval=0, maxval=23, group="Sessions")
nyEnd       = input.int(16, "New York KZ end hour",   minval=0, maxval=24, group="Sessions")

showTradeLevels = input.bool(true, "Draw entry / SL / TP", group="Trade plan")
maxPlans        = input.int(3,     "Show full plan for the last N setups (B)", minval=1, group="Trade plan")
slBuffer        = input.float(0.0, "SL buffer (price beyond the wick)", step=0.1, group="Trade plan")

showTable  = input.bool(true, "Show stats table (A)", group="Stats")
fillWindow = input.int(30,    "Cancel entry if unfilled after N chart bars", minval=1, group="Stats")

useTrend = input.bool(false, "EMA trend filter", group="Trend")
trendLen = input.int(50,     "Trend EMA length", minval=2, group="Trend")

showBox    = input.bool(true, "Show range box + equilibrium", group="Visuals")
showArrows = input.bool(true, "Show BUY/SELL labels", group="Visuals")
buyCol     = input.color(color.lime, "Bullish", group="Visuals")
sellCol    = input.color(color.red,  "Bearish", group="Visuals")
boxCol     = input.color(color.gray, "Box / equilibrium", group="Visuals")

// ------------------------------- State --------------------------------------
var int   nSignals = 0
var int   nFilled  = 0
var int   nWins    = 0
var int   nLosses  = 0
var float sumR     = 0.0
var array<Trade> active     = array.new<Trade>()
var array<line>  planLines  = array.new<line>()
var array<label> planLabels = array.new<label>()

// --------------------- Higher-timeframe data (non-repaint) ------------------
[rHigh, rLow, mHigh, mLow, mClose, rTime, mTime, htfTime] = request.security(syminfo.tickerid, crtTF, [high[2], low[2], high[1], low[1], close[1], time[2], time[1], time], lookahead=barmerge.lookahead_off)
emaVal = request.security(syminfo.tickerid, crtTF, ta.ema(close, trendLen), lookahead=barmerge.lookahead_off)

// --------------------------- Key levels (liquidity) -------------------------
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_off)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_off)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwl = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_off)

newHTF = htfTime != htfTime[1]

// ------------------------------- CRT logic ----------------------------------
sweptHigh = mHigh > rHigh
sweptLow  = mLow  < rLow
bool rawBear = sweptHigh and mClose < rHigh and (not requireInside or mClose > rLow)
bool rawBull = sweptLow  and mClose > rLow  and (not requireInside or mClose < rHigh)

bothSwept = rawBear and rawBull
rawBull := bothSwept and (mHigh - rHigh) >= (rLow - mLow) ? false : rawBull
rawBear := bothSwept and (mHigh - rHigh) <  (rLow - mLow) ? false : rawBear

keyLowGrab  = (mLow  <= pdl and mClose > pdl) or (mLow  <= pwl and mClose > pwl)
keyHighGrab = (mHigh >= pdh and mClose < pdh) or (mHigh >= pwh and mClose < pwh)
rawBull := requireKeyLevel ? (rawBull and keyLowGrab)  : rawBull
rawBear := requireKeyLevel ? (rawBear and keyHighGrab) : rawBear

mHour = hour(mTime, sessTz)
inKZ  = (mHour >= lonStart and mHour < lonEnd) or (mHour >= nyStart and mHour < nyEnd)
rawBull := useSessions ? (rawBull and inKZ) : rawBull
rawBear := useSessions ? (rawBear and inKZ) : rawBear

rawBull := useTrend ? (rawBull and mClose > emaVal) : rawBull
rawBear := useTrend ? (rawBear and mClose < emaVal) : rawBear

bullSignal = newHTF and rawBull
bearSignal = newHTF and rawBear

// ------------------- A) Simulate active trades (approximate) ----------------
if array.size(active) > 0
    int i = 0
    while i < array.size(active)
        Trade t = array.get(active, i)
        bool done = false
        if not t.filled
            if low <= t.entry and high >= t.entry
                t.filled := true
            else if bar_index - t.startBar > fillWindow
                array.remove(active, i)
                done := true
        if not done and t.filled
            bool hitSL = t.dir > 0 ? low <= t.sl : high >= t.sl
            bool hitTP = t.dir > 0 ? high >= t.tp : low <= t.tp
            if hitSL
                nFilled += 1
                nLosses += 1
                sumR    += -1.0
                array.remove(active, i)
                done := true
            else if hitTP
                nFilled += 1
                nWins   += 1
                sumR    += t.rr
                array.remove(active, i)
                done := true
        if not done
            i += 1

// ------------------------------- Drawing ------------------------------------
tfSec = timeframe.in_seconds(crtTF)
if bullSignal or bearSignal
    col       = bullSignal ? buyCol : sellCol
    eq        = (rHigh + rLow) / 2.0
    entry     = (mHigh + mLow) / 2.0
    sl        = bullSignal ? (mLow - slBuffer) : (mHigh + slBuffer)
    tp1       = bullSignal ? rHigh : rLow
    risk      = math.abs(entry - sl)
    rr1       = risk > 0 ? math.abs(tp1 - entry) / risk : 0.0
    rightTime = htfTime + (extendBars + 1) * tfSec * 1000

    if showBox
        box.new(rTime, rHigh, rightTime, rLow, xloc=xloc.bar_time, border_color=boxCol, bgcolor=color.new(boxCol, 90), border_style=line.style_dotted)
        line.new(rTime, eq, rightTime, eq, xloc=xloc.bar_time, color=color.new(boxCol, 0), style=line.style_dotted)
    if showArrows
        label.new(mTime, bullSignal ? mLow : mHigh, bullSignal ? "CRT BUY" : "CRT SELL", xloc=xloc.bar_time, style=bullSignal ? label.style_label_up : label.style_label_down, color=col, textcolor=color.white, size=size.small)
    if showTradeLevels
        line ln1 = line.new(mTime, entry, rightTime, entry, xloc=xloc.bar_time, color=color.new(color.blue, 0),  width=1)
        line ln2 = line.new(mTime, sl,    rightTime, sl,    xloc=xloc.bar_time, color=color.new(color.red, 0),    width=1)
        line ln3 = line.new(mTime, tp1,   rightTime, tp1,   xloc=xloc.bar_time, color=color.new(color.green, 0),  width=1)
        label lbl = label.new(rightTime, entry, (bullSignal ? "BUY" : "SELL") + "  E:" + str.tostring(entry, format.mintick) + "  SL:" + str.tostring(sl, format.mintick) + "  TP:" + str.tostring(tp1, format.mintick) + "  RR:" + str.tostring(rr1, "#.0"), xloc=xloc.bar_time, style=label.style_label_left, color=col, textcolor=color.white, size=size.small)
        array.push(planLines, ln1)
        array.push(planLines, ln2)
        array.push(planLines, ln3)
        array.push(planLabels, lbl)
        // B) keep the full plan only for the most recent N setups
        while array.size(planLabels) > maxPlans
            line.delete(array.shift(planLines))
            line.delete(array.shift(planLines))
            line.delete(array.shift(planLines))
            label.delete(array.shift(planLabels))

    nSignals += 1
    array.push(active, Trade.new(bullSignal ? 1 : -1, entry, sl, tp1, rr1, false, bar_index))

// ------------------------------ Key-level plots -----------------------------
plot(showKeyLevels ? pdh : na, "PDH", color=color.new(color.teal,   0), style=plot.style_stepline)
plot(showKeyLevels ? pdl : na, "PDL", color=color.new(color.teal,   0), style=plot.style_stepline)
plot(showKeyLevels ? pwh : na, "PWH", color=color.new(color.orange, 0), style=plot.style_stepline)
plot(showKeyLevels ? pwl : na, "PWL", color=color.new(color.orange, 0), style=plot.style_stepline)
plot(useTrend ? emaVal : na,   "Trend EMA", color=color.new(color.purple, 0))

// ----------------------------- A) Stats table -------------------------------
var table tbl = table.new(position.top_right, 2, 8, border_width=1, frame_color=color.gray, frame_width=1)
if showTable and barstate.islast
    float winRate = nFilled > 0 ? 100.0 * nWins / nFilled : 0.0
    color hdr = color.new(color.blue, 0)
    table.cell(tbl, 0, 0, "CRT Pro (approx)", text_color=color.white, bgcolor=hdr)
    table.cell(tbl, 1, 0, "",                 text_color=color.white, bgcolor=hdr)
    table.cell(tbl, 0, 1, "Signals", text_color=color.white, bgcolor=color.new(color.black,0)); table.cell(tbl, 1, 1, str.tostring(nSignals), text_color=color.white, bgcolor=color.new(color.black,0))
    table.cell(tbl, 0, 2, "Filled",  text_color=color.white, bgcolor=color.new(color.black,0)); table.cell(tbl, 1, 2, str.tostring(nFilled),  text_color=color.white, bgcolor=color.new(color.black,0))
    table.cell(tbl, 0, 3, "Wins",    text_color=color.white, bgcolor=color.new(color.black,0)); table.cell(tbl, 1, 3, str.tostring(nWins),    text_color=buyCol,      bgcolor=color.new(color.black,0))
    table.cell(tbl, 0, 4, "Losses",  text_color=color.white, bgcolor=color.new(color.black,0)); table.cell(tbl, 1, 4, str.tostring(nLosses),  text_color=sellCol,     bgcolor=color.new(color.black,0))
    table.cell(tbl, 0, 5, "Win %",   text_color=color.white, bgcolor=color.new(color.black,0)); table.cell(tbl, 1, 5, str.tostring(winRate,"#.0")+"%", text_color=color.white, bgcolor=color.new(color.black,0))
    table.cell(tbl, 0, 6, "Net R",   text_color=color.white, bgcolor=color.new(color.black,0)); table.cell(tbl, 1, 6, str.tostring(sumR,"#.0"), text_color=(sumR>=0?buyCol:sellCol), bgcolor=color.new(color.black,0))
    table.cell(tbl, 0, 7, "Open",    text_color=color.white, bgcolor=color.new(color.black,0)); table.cell(tbl, 1, 7, str.tostring(array.size(active)), text_color=color.white, bgcolor=color.new(color.black,0))

// -------------------------------- Alerts ------------------------------------
alertcondition(bullSignal, "CRT Pro Buy",  "CRT BUY — sweep + key level, target range high")
alertcondition(bearSignal, "CRT Pro Sell", "CRT SELL — sweep + key level, target range low")
