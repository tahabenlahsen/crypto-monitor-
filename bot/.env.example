# Copy this file to `.env` and fill in your MetaTrader 5 DEMO account details.
# NEVER commit the real .env file - it is already in .gitignore.
# Get these from your broker after opening an MT5 (start with a DEMO) account.

MT5_LOGIN=12345678
MT5_PASSWORD=your-mt5-password
MT5_SERVER=YourBroker-Demo
